import React, { useState, useEffect } from 'react';
import { AppView, Language, Choice, StoryScene, MemoryShard } from './types/story';
import { STORY_SCENES, INITIAL_MEMORIES } from './data/storyData';
import { audioEngine } from './utils/audioEngine';
import { TopNav } from './components/TopNav';
import { TitleMenu } from './components/TitleMenu';
import { StoryView } from './components/StoryView';
import { MemoryArchive } from './components/MemoryArchive';
import { VoiceStudio } from './components/VoiceStudio';
import { CreditsView } from './components/CreditsView';
import { ApkDownloadModal } from './components/ApkDownloadModal';
import { SourceCodeViewer } from './components/SourceCodeViewer';

export default function App() {
  const [currentView, setCurrentView] = useState<AppView>('TITLE');
  const [lang, setLang] = useState<Language>('ar');
  const [currentSceneId, setCurrentSceneId] = useState<string>('intro');
  const [powerLevel, setPowerLevel] = useState<number>(10);
  const [memoryIntegrity, setMemoryIntegrity] = useState<number>(100);
  const [memories, setMemories] = useState<MemoryShard[]>(INITIAL_MEMORIES);
  const [ambienceEnabled, setAmbienceEnabled] = useState<boolean>(false);
  const [isApkModalOpen, setIsApkModalOpen] = useState<boolean>(false);

  useEffect(() => {
    document.documentElement.lang = lang;
    document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
  }, [lang]);

  const toggleAmbience = () => {
    const nextState = !ambienceEnabled;
    setAmbienceEnabled(nextState);
    audioEngine.toggleAmbience(nextState);
  };

  const handleChoiceSelect = (choice: Choice) => {
    const nextPower = Math.min(100, Math.max(0, powerLevel + choice.powerDelta));
    const nextMemory = Math.min(100, Math.max(0, memoryIntegrity + choice.memoryDelta));

    setPowerLevel(nextPower);
    setMemoryIntegrity(nextMemory);

    setMemories((prev) =>
      prev.map((mem) => {
        if (nextPower >= mem.thresholdPower) {
          return { ...mem, lost: true };
        }
        return mem;
      })
    );

    if (STORY_SCENES[choice.nextSceneId]) {
      setCurrentSceneId(choice.nextSceneId);
    }
  };

  const handleRestart = () => {
    audioEngine.stopTTS();
    setPowerLevel(10);
    setMemoryIntegrity(100);
    setMemories(INITIAL_MEMORIES.map((m) => ({ ...m, lost: false })));
    setCurrentSceneId('intro');
    setCurrentView('STORY');
  };

  const handleTriggerMemoryLoss = (memId: string) => {
    setMemories((prev) =>
      prev.map((m) => (m.id === memId ? { ...m, lost: true } : m))
    );
  };

  const currentScene: StoryScene = STORY_SCENES[currentSceneId] || STORY_SCENES['intro'];

  return (
    <div className="min-h-screen flex flex-col bg-[#030712] text-slate-100 selection:bg-rose-500/30 selection:text-rose-200">
      <TopNav
        currentView={currentView}
        setCurrentView={(view) => {
          audioEngine.playChoiceClick();
          setCurrentView(view);
        }}
        lang={lang}
        setLang={setLang}
        ambienceEnabled={ambienceEnabled}
        toggleAmbience={toggleAmbience}
        powerLevel={powerLevel}
        memoryIntegrity={memoryIntegrity}
        onOpenApkModal={() => setIsApkModalOpen(true)}
      />

      <main className="flex-1 w-full">
        {currentView === 'TITLE' && (
          <TitleMenu
            onStartStory={() => {
              audioEngine.playChoiceClick();
              setCurrentView('STORY');
            }}
            onOpenMemories={() => {
              audioEngine.playChoiceClick();
              setCurrentView('MEMORIES');
            }}
            onOpenStudio={() => {
              audioEngine.playChoiceClick();
              setCurrentView('STUDIO');
            }}
            onOpenApkModal={() => setIsApkModalOpen(true)}
            lang={lang}
          />
        )}

        {currentView === 'STORY' && (
          <StoryView
            currentScene={currentScene}
            onChoiceSelect={handleChoiceSelect}
            onRestart={handleRestart}
            powerLevel={powerLevel}
            memoryIntegrity={memoryIntegrity}
            lang={lang}
            onTriggerMemoryLoss={handleTriggerMemoryLoss}
          />
        )}

        {currentView === 'MEMORIES' && (
          <MemoryArchive
            memories={memories}
            powerLevel={powerLevel}
            memoryIntegrity={memoryIntegrity}
            lang={lang}
          />
        )}

        {currentView === 'STUDIO' && <VoiceStudio lang={lang} />}
        {currentView === 'CODE' && <SourceCodeViewer lang={lang} />}

        {currentView === 'CREDITS' && (
          <CreditsView
            onBackToStory={() => setCurrentView('STORY')}
            lang={lang}
          />
        )}
      </main>

      <ApkDownloadModal
        isOpen={isApkModalOpen}
        onClose={() => setIsApkModalOpen(false)}
        lang={lang}
      />

      <footer className="w-full border-t border-slate-900 bg-slate-950/80 py-4 px-6 text-center text-xs text-slate-500 font-arabic">
        <div className="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
          <span>
            {lang === 'ar'
              ? 'ثمن القوة: ذاكرة ريو — رواية تفاعلية مدعومة بمحرك gemini-3.8-flash-tts'
              : "The Price of Power: Ryo's Memory — Interactive Novel powered by gemini-3.8-flash-tts"}
          </span>
          <span className="text-slate-600 font-mono text-[11px]">
            PWR {powerLevel}% · MEM {memoryIntegrity}% · 24kHz Unary WAV
          </span>
        </div>
      </footer>
    </div>
  );
}


