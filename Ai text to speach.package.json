import React from 'react';
import { Language } from '../types/story';
import { Eye, EyeOff, AlertTriangle } from 'lucide-react';

interface SisterFaceOverlayProps {
  memoryIntegrity: number; // 0 to 100
  powerLevel: number;
  lang: Language;
}

export const SisterFaceOverlay: React.FC<SisterFaceOverlayProps> = ({
  memoryIntegrity,
  powerLevel,
  lang,
}) => {
  const blurAmount = Math.max(0, (100 - memoryIntegrity) * 0.16);
  const grayscaleAmount = Math.min(100, Math.max(0, (100 - memoryIntegrity) * 1.1));
  const brightness = 1 + (100 - memoryIntegrity) * 0.005;

  let stateLabelAr = 'وجه مايا واضح تماماً ودافئ';
  let stateLabelEn = "Maya's face is radiant and clear";

  if (memoryIntegrity < 20) {
    stateLabelAr = 'تلاشى الوجه تماماً... مجرد شبح أبيض مجهول';
    stateLabelEn = 'Face dissolved completely into hollow white mist';
  } else if (memoryIntegrity < 50) {
    stateLabelAr = 'الملامح مشوشة والعيون بلا بريق';
    stateLabelEn = 'Features blurred, eyes fading into haze';
  } else if (memoryIntegrity < 80) {
    stateLabelAr = 'حواف الذكرى بدأت تتكسر كالزجاج';
    stateLabelEn = 'Edges of memory fracturing like glass';
  }

  return (
    <div className="relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/60 p-4 shadow-xl flex flex-col gap-3">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2">
          {memoryIntegrity > 30 ? (
            <Eye className="w-4 h-4 text-rose-400" />
          ) : (
            <EyeOff className="w-4 h-4 text-rose-500 animate-pulse" />
          )}
          <span className="text-sm font-semibold text-slate-200">
            {lang === 'ar' ? 'صورة أخته مايا في وجدان ريو' : "Maya's Face in Ryo's Mind"}
          </span>
        </div>
        <div className="text-xs font-mono tabular-nums text-slate-400">
          {lang === 'ar' ? 'وضوح الملامح' : 'Clarity'}:{' '}
          <span className="font-bold text-rose-400">{memoryIntegrity}%</span>
        </div>
      </div>

      <div className="relative aspect-4/3 w-full rounded-xl overflow-hidden bg-slate-950 border border-slate-800/80 group">
        <img
          src="/src/assets/images/sister_maya_memory_1792484435516.jpg"
          alt="Maya's memory portrait"
          referrerPolicy="no-referrer"
          className="w-full h-full object-cover transition-all duration-700 select-none"
          style={{
            filter: `blur(${blurAmount}px) grayscale(${grayscaleAmount}%) brightness(${brightness})`,
            transform: memoryIntegrity < 25 ? 'scale(1.05)' : 'scale(1)',
          }}
        />

        {memoryIntegrity <= 15 && (
          <div className="absolute inset-0 bg-slate-950/40 backdrop-blur-sm flex flex-col items-center justify-center text-center p-4">
            <AlertTriangle className="w-8 h-8 text-rose-400 mb-2 opacity-80" />
            <p className="text-xs sm:text-sm font-semibold text-rose-200 drop-shadow">
              {lang === 'ar'
                ? 'لم يعد ريو يتذكر شكل عينيها أو ابتسامتها...'
                : 'Ryo can no longer recall the shape of her eyes...'}
            </p>
          </div>
        )}

        <div className="absolute bottom-2 left-2 right-2 px-3 py-1.5 rounded-lg backdrop-blur-md bg-slate-950/70 border border-slate-700/60 flex items-center justify-between text-xs">
          <span className="text-slate-300 truncate font-arabic">
            {lang === 'ar' ? stateLabelAr : stateLabelEn}
          </span>
          <span className="text-slate-500 font-mono text-[11px] shrink-0 ml-2">
            PWR: {powerLevel}%
          </span>
        </div>
      </div>
    </div>
  );
};


