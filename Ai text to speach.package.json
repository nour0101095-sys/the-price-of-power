import express from 'express';
import { createServer as createViteServer } from 'vite';
import path from 'path';
import { fileURLToPath } from 'url';
import fs from 'fs';
import dotenv from 'dotenv';
import { GoogleGenAI } from '@google/genai';

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = Number(process.env.PORT) || 3000;

app.use(express.json({ limit: '10mb' }));

// Server-side Gemini initialization with User-Agent header as required
const ai = new GoogleGenAI({
  apiKey: process.env.GEMINI_API_KEY,
  httpOptions: {
    headers: {
      'User-Agent': 'aistudio-build',
    },
  },
});

// Text-To-Speech endpoint using gemini-3.8-flash-tts
app.post('/api/tts', async (req, res) => {
  try {
    const { text, speaker = 'Narrator', style, voiceName = 'Fenrir' } = req.body;

    if (!text || typeof text !== 'string') {
      return res.status(400).json({ error: 'Text prompt is required' });
    }

    if (!process.env.GEMINI_API_KEY) {
      return res.status(503).json({
        error: 'GEMINI_API_KEY is not configured in environment',
        fallback: true,
      });
    }

    // Call gemini-3.8-flash-tts with emotional speech direction
    const response = await ai.models.generateContent({
      model: 'gemini-3.8-flash-tts',
      contents: [
        {
          role: 'user',
          parts: [
            {
              text: text.trim(),
              speechMetadata: {
                speaker: speaker,
                style: style || 'Cinematic, emotional, intense anime drama storytelling with deep feeling',
              },
            },
          ],
        },
      ],
      config: {
        responseModalities: ['AUDIO'],
        speechConfig: {
          voiceConfig: {
            prebuiltVoiceConfig: {
              voiceName: voiceName, // Puck, Charon, Kore, Fenrir, Zephyr
            },
          },
        },
      },
    });

    const base64Audio = response.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data;

    if (!base64Audio) {
      return res.status(500).json({ error: 'No audio returned from Gemini TTS model', fallback: true });
    }

    // Unary default is complete WAV file (audio/wav, RIFF header, 24kHz mono 16-bit)
    return res.json({
      audioBase64: base64Audio,
      mimeType: 'audio/wav',
      model: 'gemini-3.8-flash-tts',
      speaker,
      voiceName,
    });
  } catch (err: any) {
    console.error('Error generating speech with gemini-3.8-flash-tts:', err);
    return res.status(500).json({
      error: err.message || 'Failed to generate speech with gemini-3.8-flash-tts',
      fallback: true,
    });
  }
});

// Story progression generator if user asks Gemini to generate next alternate branch
app.post('/api/gemini/generate-branch', async (req, res) => {
  try {
    const { currentChapter, memoryLossPercent, playerPower, chosenSacrifice } = req.body;

    if (!process.env.GEMINI_API_KEY) {
      return res.status(503).json({ error: 'GEMINI_API_KEY is not configured' });
    }

    const prompt = `You are the lead narrative director for a dark fantasy visual novel in Arabic and English.
Context:
- Main Character: Ryo (ريو)
- Core Dilemma: "تخيل إنك تقدر تبقى أقوى واحد في العالم... بس كل ما تقوى، تنسى حد بتحبه. ريو هيضطر يختار بين إنه ينقذ أخته... وإنه يفتكر وشها." (Gain immense godlike power to save his sister Maya, but each tier of power permanently burns away his memories of her face, voice, and bond).
- Current Memory Loss: ${memoryLossPercent}%
- Current Power Level: ${playerPower}%
- Last Decision: "${chosenSacrifice}"

Generate a short dramatic chapter continuation (in Arabic + English translation) where Ryo experiences the bittersweet consequences of this choice. Return JSON with:
{
  "arabicTitle": "...",
  "englishTitle": "...",
  "arabicNarrative": "...",
  "englishNarrative": "...",
  "memoryFragmentText": "...",
  "nextChoices": [
    { "textAr": "...", "textEn": "...", "powerGain": number, "memoryLost": number },
    { "textAr": "...", "textEn": "...", "powerGain": number, "memoryLost": number }
  ]
}`;

    const response = await ai.models.generateContent({
      model: 'gemini-3.8-flash',
      contents: prompt,
      config: {
        responseMimeType: 'application/json',
      },
    });

    return res.json(JSON.parse(response.text || '{}'));
  } catch (err: any) {
    console.error('Error generating dynamic story branch:', err);
    return res.status(500).json({ error: err.message || 'Failed to generate branch' });
  }
});

async function startServer() {
  const distPath = path.resolve(__dirname, 'dist');
  const isProd = process.env.NODE_ENV === 'production' || (fs.existsSync(distPath) && fs.existsSync(path.resolve(distPath, 'index.html')));

  if (isProd) {
    app.use(express.static(distPath));
    app.get('*', (_req, res) => {
      res.sendFile(path.resolve(distPath, 'index.html'));
    });
  } else {
    const vite = await createViteServer({
      server: {
        middlewareMode: true,
        hmr: false,
        watch: null,
      },
      appType: 'spa',
    });
    app.use(vite.middlewares);
  }

  app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server listening on http://0.0.0.0:${PORT}`);
  });
}

startServer();


