// FILE: src/utils/audioEngine.ts
// ======================================

class AudioEngine {
  private audioCtx: AudioContext | null = null;
  private isAmbiencePlaying: boolean = false;
  private masterGain: GainNode | null = null;
  private droneOsc1: OscillatorNode | null = null;
  private droneOsc2: OscillatorNode | null = null;
  private currentAudioElement: HTMLAudioElement | null = null;

  private initContext() {
    if (!this.audioCtx) {
      const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
      this.audioCtx = new AudioCtxClass();
      this.masterGain = this.audioCtx.createGain();
      this.masterGain.gain.setValueAtTime(0.3, this.audioCtx.currentTime);
      this.masterGain.connect(this.audioCtx.destination);
    }
    if (this.audioCtx.state === 'suspended') {
      this.audioCtx.resume();
    }
  }

  public toggleAmbience(enabled: boolean) {
    if (!enabled) {
      this.stopAmbience();
      return;
    }
    this.startAmbience();
  }

  public startAmbience() {
    if (this.isAmbiencePlaying) return;
    try {
      this.initContext();
      if (!this.audioCtx || !this.masterGain) return;

      const now = this.audioCtx.currentTime;
      this.droneOsc1 = this.audioCtx.createOscillator();
      this.droneOsc2 = this.audioCtx.createOscillator();
      const droneGain = this.audioCtx.createGain();

      this.droneOsc1.type = 'sawtooth';
      this.droneOsc1.frequency.setValueAtTime(55, now);

      this.droneOsc2.type = 'sine';
      this.droneOsc2.frequency.setValueAtTime(82.4, now);

      const filter = this.audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(140, now);

      droneGain.gain.setValueAtTime(0.001, now);
      droneGain.gain.linearRampToValueAtTime(0.08, now + 3);

      this.droneOsc1.connect(filter);
      this.droneOsc2.connect(filter);
      filter.connect(droneGain);
      droneGain.connect(this.masterGain);

      this.droneOsc1.start();
      this.droneOsc2.start();
      this.isAmbiencePlaying = true;
    } catch (err) {
      console.warn('Could not start ambient synthesizer:', err);
    }
  }

  public stopAmbience() {
    try {
      if (this.droneOsc1) {
        this.droneOsc1.stop();
        this.droneOsc1.disconnect();
        this.droneOsc1 = null;
      }
      if (this.droneOsc2) {
        this.droneOsc2.stop();
        this.droneOsc2.disconnect();
        this.droneOsc2 = null;
      }
      this.isAmbiencePlaying = false;
    } catch (err) {
      console.warn('Error stopping ambience:', err);
    }
  }

  public playMemoryShatter() {
    try {
      this.initContext();
      if (!this.audioCtx || !this.masterGain) return;
      const now = this.audioCtx.currentTime;

      const chimeOsc = this.audioCtx.createOscillator();
      const chimeGain = this.audioCtx.createGain();
      chimeOsc.type = 'sine';
      chimeOsc.frequency.setValueAtTime(1200, now);
      chimeOsc.frequency.exponentialRampToValueAtTime(300, now + 1.2);

      chimeGain.gain.setValueAtTime(0.2, now);
      chimeGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.2);

      chimeOsc.connect(chimeGain);
      chimeGain.connect(this.masterGain);
      chimeOsc.start(now);
      chimeOsc.stop(now + 1.2);
    } catch (err) {
      console.warn('Error playing memory shatter FX:', err);
    }
  }

  public playChoiceClick() {
    try {
      this.initContext();
      if (!this.audioCtx || !this.masterGain) return;
      const now = this.audioCtx.currentTime;

      const osc = this.audioCtx.createOscillator();
      const gain = this.audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, now);
      osc.frequency.exponentialRampToValueAtTime(880, now + 0.15);

      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);

      osc.connect(gain);
      gain.connect(this.masterGain);
      osc.start(now);
      osc.stop(now + 0.15);
    } catch {}
  }

  public stopTTS() {
    if (this.currentAudioElement) {
      this.currentAudioElement.pause();
      this.currentAudioElement.currentTime = 0;
      this.currentAudioElement = null;
    }
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
  }

  public async playGeminiTTS(params: {
    text: string;
    speaker?: string;
    style?: string;
    voiceName?: 'Fenrir' | 'Kore' | 'Puck' | 'Charon' | 'Zephyr';
    language?: 'ar' | 'en';
    onStart?: () => void;
    onEnd?: () => void;
    onError?: (err: any) => void;
  }): Promise<{ audioUrl?: string; isFallback?: boolean }> {
    this.stopTTS();
    params.onStart?.();

    try {
      const response = await fetch('/api/tts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text: params.text,
          speaker: params.speaker || 'Narrator',
          style: params.style || 'Cinematic, emotional dark fantasy drama narration',
          voiceName: params.voiceName || 'Fenrir',
        }),
      });

      if (!response.ok) {
        throw new Error(`TTS server responded with ${response.status}`);
      }

      const data = await response.json();

      if (data.audioBase64) {
        const audioSrc = `data:${data.mimeType || 'audio/wav'};base64,${data.audioBase64}`;
        const audio = new Audio(audioSrc);
        this.currentAudioElement = audio;

        audio.onended = () => {
          this.currentAudioElement = null;
          params.onEnd?.();
        };

        audio.onerror = () => {
          this.fallbackSpeech(params);
        };

        await audio.play();
        return { audioUrl: audioSrc, isFallback: false };
      } else {
        throw new Error('No audioBase64 in response');
      }
    } catch (err: any) {
      this.fallbackSpeech(params);
      return { isFallback: true };
    }
  }

  private fallbackSpeech(params: {
    text: string;
    language?: 'ar' | 'en';
    onEnd?: () => void;
  }) {
    if (!('speechSynthesis' in window)) {
      params.onEnd?.();
      return;
    }

    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(params.text);
    utterance.lang = params.language === 'en' ? 'en-US' : 'ar-SA';
    utterance.rate = 0.95;
    utterance.pitch = 0.9;
    utterance.onend = () => params.onEnd?.();
    window.speechSynthesis.speak(utterance);
  }
}

export const audioEngine = new AudioEngine();


